# Server Environment Configuration
PORT=3000
NODE_ENV=development

# Supabase PostgreSQL Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Found under "Project API keys" -> "service_role" (keep private, never share on frontend or git!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Municipal Administrator API Key (used by staff to update report statuses)
# Generate a strong key with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=your-secure-admin-api-key-here
